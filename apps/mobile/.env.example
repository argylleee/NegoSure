# Copy to .env.local and fill in real values for local development.
# Never commit .env.local — it's gitignored.
#
# ONLY variables prefixed EXPO_PUBLIC_ belong here. Expo inlines them into
# the client bundle at build time, so anything here is visible to anyone
# who inspects the app. Never put a secret key, service-role key, or
# provider API key in this file — see .claude/CLAUDE.md §13.

# Base URL of the NegoSure API (services/api). Not deployed yet — this is
# a placeholder for when the backend exists.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase project's public URL and anon/publishable key — these are the
# client-safe Supabase credentials, not the service-role key. Fill in once
# a Supabase project exists.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
