# Forward-looking template — services/api has no implementation yet
# (Phase 2+). This documents what the backend will need per
# .claude/CLAUDE.md §1, so the shape is agreed before the code exists.
# Copy to .env, never commit .env with real values.

NODE_ENV=development
PORT=3000

# PostgreSQL (Supabase-hosted in development per the free-first constraint,
# or local Postgres if Supabase isn't set up yet)
DATABASE_URL=postgresql://user:password@localhost:5432/negosure

# Redis (BullMQ job queues)
REDIS_URL=redis://localhost:6379

# Supabase — service-role key is a SECRET, backend-only. Never expose it to
# the mobile app (that uses EXPO_PUBLIC_SUPABASE_ANON_KEY instead).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — never hard-code the app to one; see .claude/CLAUDE.md §10.
# Ollama needs no key (local). Gemini/Groq keys are optional dev fallbacks.
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
GROQ_API_KEY=

# Auth token signing — generate a real random secret for each environment,
# never reuse this placeholder.
JWT_SECRET=changeme
