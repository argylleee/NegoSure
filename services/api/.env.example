# Copy to .env, never commit .env with real values.

NODE_ENV=development
PORT=3000

# PostgreSQL — Supabase-hosted in development per the free-first constraint.
# Both come from Supabase Project Settings -> Database.
#
# DATABASE_URL: the transaction pooler (port 6543) — used at runtime.
# MUST keep ?pgbouncer=true — without it Prisma's prepared statements
# collide across pooled connections ("prepared statement already exists").
#
# DIRECT_URL: used by Prisma migrations. Supabase's actual "direct"
# connection (db.<ref>.supabase.co:5432) is IPv6-only and unreachable from
# many networks/sandboxes — use the session pooler instead (same pooler
# host as DATABASE_URL, but port 5432, no pgbouncer param). It's IPv4 and
# supports the prepared statements migrations need.
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase — from Project Settings -> API. The service-role key is a
# SECRET, backend-only. Never expose it to the mobile app (that uses
# EXPO_PUBLIC_SUPABASE_ANON_KEY instead, which is public-safe).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# No JWT secret needed: this project signs access tokens with a per-project
# asymmetric key (ES256), verified via SUPABASE_URL's JWKS endpoint — see
# middleware/auth.ts. A project still on the legacy shared HS256 secret
# would need a different verification path; check the token's header
# ("alg") before assuming which applies.

# Redis (BullMQ job queues) — not wired up yet, deferred until a phase
# that actually needs a queue.
REDIS_URL=redis://localhost:6379

# AI providers — never hard-code the app to one; see .claude/CLAUDE.md §10.
# Not wired up yet, deferred to the AI phase.
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
GROQ_API_KEY=
